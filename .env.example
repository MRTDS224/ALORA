# App Configuration
APP_NAME=ALORA
APP_ENV=development
SECRET_KEY=supersecretkey-change-in-production-12345
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=alora_user
POSTGRES_PASSWORD=alora_password
POSTGRES_DB=alora_db

# MinIO / S3 Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=alora-storage
MINIO_SECURE=false

# Initial Admin Account (change in production!)
ADMIN_EMAIL=admin@alora.local
ADMIN_PASSWORD=change-me-strong-password
ADMIN_FULL_NAME=Administrateur ALORA
SESSION_MAX_AGE_SECONDS=604800
