# App Configuration
APP_NAME=ALORA
APP_ENV=development
SECRET_KEY=<GENERATE_RANDOM_SECRET_KEY>
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
# Option 1 (Cloud: Render / Neon / Railway): set DATABASE_URL directly
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/alora_db
# Option 2 (Local Docker Compose):
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=alora_user
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=alora_db

# Storage Backend: "minio" (MinIO / Cloudflare R2 / S3) or "local" (demo disk fallback)
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=/tmp/alora-storage

# MinIO / S3 Storage (used when STORAGE_BACKEND=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<MINIO_SECRET_KEY>
MINIO_BUCKET_NAME=alora-storage
MINIO_SECURE=false

# Initial Admin Account (required for automatic admin bootstrap)
ADMIN_EMAIL=admin@alora.local
ADMIN_PASSWORD=<ADMIN_PASSWORD>
ADMIN_FULL_NAME=Administrateur ALORA
SESSION_MAX_AGE_SECONDS=604800

# Multi-reviewer transcription quorum & structured JSON logging
TRANSCRIPTION_REQUIRED_APPROVALS=2
LOG_LEVEL=INFO

# Multi-language extensibility (ISO 639-3 codes; 'sus' active by default)
DEFAULT_LANGUAGE=sus
ACTIVE_LANGUAGES=sus
